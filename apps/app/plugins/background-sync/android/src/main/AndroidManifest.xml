<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- The short foreground service that holds the process while a sync that
        was under way when the user left is finished. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <!-- So that its notification can be shown on Android 13 and later. The
        service runs, and ends, without it being granted. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application>
        <service
            android:name=".SyncHoldService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />
    </application>
</manifest>
