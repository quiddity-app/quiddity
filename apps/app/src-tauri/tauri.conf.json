{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Quiddity",
  "version": "0.1.0",
  "identifier": "uk.co.aylett.quiddity",
  "build": {
    "beforeDevCommand": "pnpm --filter @quiddity/ui dev",
    "devUrl": "http://localhost:3000",
    "beforeBuildCommand": "pnpm --filter @quiddity/ui build",
    "frontendDist": "../../ui/out"
  },
  "app": {
    "windows": [
      {
        "title": "Quiddity",
        "width": 1280,
        "height": 800,
        "minWidth": 480,
        "minHeight": 400
      }
    ],
    "security": {
      "csp": null
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "",
      "endpoints": [
        "https://github.com/quiddity-app/quiddity/releases/latest/download/latest.json"
      ]
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
